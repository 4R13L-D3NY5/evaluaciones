# =============================================================================
# Sistema de Evaluaciones SEA/SISA - Variables de Entorno
# Stack: Angular + Spring Boot + PostgreSQL + Python Workers
# =============================================================================

# -----------------------------------------------------------------------------
# Base de Datos (PostgreSQL 16)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sea_evaluaciones
DB_USERNAME=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Backend Spring Boot
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=cambia_este_secreto_por_una_cadena_larga_y_aleatoria_de_al_menos_64_caracteres
JWT_EXPIRATION_MS=86400000

# Directorio donde se almacenan PDFs, XLSX, imágenes y archivos Typst
STORAGE_BASE_PATH=C:/laragon/www/evaluaciones/storage

# -----------------------------------------------------------------------------
# Gateway Institucional UNITEPC (OAuth2 Client Credentials)
# -----------------------------------------------------------------------------
UNITEPC_GATEWAY_BASE_URL=https://gw-dev.unitepc.solutions
UNITEPC_CLIENT_ID=dev-syseng-research
UNITEPC_CLIENT_SECRET=cambia_este_secret_o_usa_el_real_del_gateway
UNITEPC_SYSTEM_CLIENT_ID=sea-evaluaciones

# -----------------------------------------------------------------------------
# Workers Python
# -----------------------------------------------------------------------------
PYTHON_WORKER_TYPST_ENABLED=true
PYTHON_WORKER_OMR_ENABLED=true
TYPST_CLI_PATH=C:/laragon/www/evaluaciones/typst.exe

# -----------------------------------------------------------------------------
# RabbitMQ (broker para workers)
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# -----------------------------------------------------------------------------
# Frontend Angular (dev)
# -----------------------------------------------------------------------------
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080/api

# -----------------------------------------------------------------------------
# Vault Transit (la KEK vive dentro de Vault; no guardarla en esta configuración)
# En producción usar VAULT_TOKEN_FILE apuntando a un secreto protegido.
# -----------------------------------------------------------------------------
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN_FILE=
VAULT_BACKEND_TOKEN=
VAULT_WORKER_TOKEN=
VAULT_OMR_TOKEN=
VAULT_PORT=8200
VAULT_TRANSIT_KEY_NAME=sea-banco-kek
VAULT_TIMEOUT_SECONDS=10
KMS_MIGRATION_ENABLED=false
KMS_ROTATION_ENABLED=false

# -----------------------------------------------------------------------------
# Respaldos administrables (el destino externo se configura en el despliegue)
# -----------------------------------------------------------------------------
BACKUP_EXTERNAL_PATH=./backups-external
BACKUP_LOCAL_PATH=./backups
BACKUP_RESTIC_PASSWORD_FILE=./vault/secrets/restic-password
