FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client restic ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-backup.txt .
RUN pip install --no-cache-dir -r requirements-backup.txt

COPY backup_worker.py .

ENV RESTIC_BIN=/usr/bin/restic
ENV RESTIC_PASSWORD_FILE=/run/secrets/restic_password
CMD ["python", "backup_worker.py"]
